source "https://rubygems.org"

# Match the dependency set used by GitHub Pages. Pinning this makes local/CI
# builds representative of the server-side GitHub Pages build.
gem "github-pages", "~> 232", group: :jekyll_plugins

# WEBrick is only needed for `jekyll serve` on modern Ruby; it is not a
# Jekyll plugin and does not affect the GitHub Pages build.
gem "webrick", "~> 1.8"

gem "wdm", "~> 0.1.0" if Gem.win_platform?
